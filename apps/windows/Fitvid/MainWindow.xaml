<Window
    x:Class="Fitvid.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="fitvid">
  <Grid>
    <!-- Wizard -->
    <StackPanel x:Name="WizardPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" MaxWidth="560">
      <TextBlock Text="fitvid" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>
      <TextBlock x:Name="WizardTitle" FontSize="22" HorizontalAlignment="Center"/>
      <TextBlock x:Name="WizardSubtitle" TextWrapping="Wrap" Opacity="0.7" HorizontalAlignment="Center" TextAlignment="Center"/>

      <!-- FIT / device clock sync forms (shown on sync steps) -->
      <StackPanel x:Name="FitSyncPanel" Spacing="8" Visibility="Collapsed" MaxWidth="520">
        <TextBox x:Name="FitLabelBox" Header="Device label"/>
        <TextBox x:Name="FitReferenceBox" Header="FIT reference (ISO)"/>
        <TextBox x:Name="WatchClockBox" Header="Watch showed (ISO)"/>
        <TextBox x:Name="WallClockBox" Header="Wall clock / phone (optional ISO)"/>
      </StackPanel>
      <StackPanel x:Name="DeviceSyncPanel" Spacing="8" Visibility="Collapsed" MaxWidth="520">
        <TextBlock x:Name="DeviceSyncTitle" FontWeight="SemiBold"/>
        <StackPanel x:Name="DeviceSyncHost" Spacing="10"/>
      </StackPanel>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
        <Button x:Name="PrimaryWizardButton" Click="PrimaryWizardButton_Click" Style="{StaticResource AccentButtonStyle}"/>
        <Button x:Name="SkipAudioButton" Content="Skip" Click="SkipAudioButton_Click" Visibility="Collapsed"/>
      </StackPanel>
      <TextBlock x:Name="StatusText" Opacity="0.8" HorizontalAlignment="Center"/>
    </StackPanel>

    <!-- Main -->
    <Grid x:Name="MainPanel" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="300"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Padding="12">
          <StackPanel>
            <TextBlock Text="Telemetry" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock Text="Units" Opacity="0.7" FontSize="12" Margin="0,0,0,4"/>
            <ComboBox x:Name="UnitSystemBox" SelectionChanged="UnitSystem_SelectionChanged" SelectedIndex="0" Margin="0,0,0,8" Width="200">
              <ComboBoxItem Content="FPS"/>
              <ComboBoxItem Content="Metric"/>
            </ComboBox>
            <ListView x:Name="FieldList" Height="380"/>
            <ToggleSwitch x:Name="MapToggle" Header="Route map overlay" Toggled="MapToggle_Toggled" Visibility="Collapsed"/>
          </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="Highlights" FontWeight="SemiBold"/>
            <ComboBox x:Name="ModeBox" SelectionChanged="Mode_SelectionChanged" SelectedIndex="0" Width="240">
              <ComboBoxItem Content="All videos"/>
              <ComboBoxItem Content="Laps"/>
              <ComboBoxItem Content="Threshold"/>
              <ComboBoxItem Content="Manual"/>
            </ComboBox>
            <StackPanel x:Name="ThresholdPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
              <TextBox x:Name="ThresholdFieldBox" Header="Field" Width="140"/>
              <TextBox x:Name="ThresholdOpBox" Header="Op" Text=">" Width="60"/>
              <NumberBox x:Name="ThresholdValueBox" Header="Value" Width="100"/>
              <NumberBox x:Name="ThresholdMinBox" Header="Min s" Value="5" Width="80"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <NumberBox x:Name="PadBefore" Header="Pad before (s)" Value="2" Minimum="0" Maximum="60" Width="140"/>
              <NumberBox x:Name="PadAfter" Header="Pad after (s)" Value="2" Minimum="0" Maximum="60" Width="140"/>
            </StackPanel>
            <TextBox x:Name="OutputBox" Header="Output" Text="highlight.mp4"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Dry run" Click="DryRun_Click"/>
              <Button Content="Generate" Click="Compile_Click" Style="{StaticResource AccentButtonStyle}"/>
            </StackPanel>
            <TextBlock Text="Log" FontWeight="SemiBold"/>
            <TextBox x:Name="LogBox" AcceptsReturn="True" TextWrapping="Wrap" Height="220" IsReadOnly="True" FontFamily="Consolas"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Border Grid.Row="1" Padding="8" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" MinHeight="260" MaxHeight="340">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="180"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Videos by source" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <Button Content="+" Click="AddVideos_Click"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="280">
              <StackPanel x:Name="VideoSourceHost" Spacing="10"/>
            </ScrollViewer>
          </StackPanel>
          <Border Grid.Column="1" Width="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="8,0"/>
          <StackPanel Grid.Column="2" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Audio by source" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <Button Content="+" Click="AddAudio_Click"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="280">
              <StackPanel x:Name="AudioSourceHost" Spacing="10"/>
            </ScrollViewer>
          </StackPanel>
          <Border Grid.Column="3" Width="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="8,0"/>
          <StackPanel Grid.Column="4" Spacing="6">
            <TextBlock Text="FIT" FontWeight="SemiBold"/>
            <StackPanel x:Name="FitIconHost" Orientation="Horizontal"/>
            <TextBlock x:Name="FitDockLabel" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock x:Name="FitDockTime" FontSize="11" Opacity="0.7" TextWrapping="Wrap" FontFamily="Consolas"/>
            <Button Content="Change…" Click="ChangeFit_Click"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
